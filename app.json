{
  "expo": {
    "name": "Teamapp",
    "slug": "teamapp",
    "scheme": "teamapp",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.teamapp.pilot"
    },
    "android": {
      "package": "de.teamapp.pilot",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
